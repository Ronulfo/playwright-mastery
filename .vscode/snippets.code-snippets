{

	
  "Playwright test": {
    "scope": "typescript",
    "prefix": "pwt",
    "body": [
      "test('${1:description}', async ({ page }) => {",
      "\t$0",
      "});"
    ]
  },
  "Playwright describe": {
    "scope": "typescript",
    "prefix": "pwd",
    "body": [
      "test.describe('${1:feature}', () => {",
      "\t$0",
      "});"
    ]
  },
  "Playwright beforeEach": {
    "scope": "typescript",
    "prefix": "pwbe",
    "body": [
      "test.beforeEach(async ({ page }) => {",
      "\tawait page.goto('${1:/}');",
      "});"
    ]
  },
  "Playwright imports": {
    "scope": "typescript",
    "prefix": "pwi",
    "body": ["import { test, expect } from '@playwright/test';", "$0"]
  }

	// Place your playwright-mastery workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and 
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope 
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is 
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are: 
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. 
	// Placeholders with the same ids are connected.
